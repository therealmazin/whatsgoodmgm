# WhatsGoodMGM environment variables
# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Public (safe to share; enough to run the site locally) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=r4b3vt07
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical site origin for sitemap/OG/JSON-LD. Leave unset locally;
# production uses https://whatsgoodmgm.com.
# NEXT_PUBLIC_SITE_URL=https://whatsgoodmgm.com

# --- Maintainers only (ask before you need these) ---
# Optional while the dataset is public; required if it ever goes private.
# Sanity API token with Viewer access. Used by every page that reads events.
# Falls back to SANITY_WRITE_TOKEN when unset.
SANITY_READ_TOKEN=

# Sanity API token with write access. Used by /submit, npm run ingest, and
# scripts that write (geocode-venues, tag-interests, write-extracted).
SANITY_WRITE_TOKEN=

# Shared secret for POST /api/revalidate (called by the Sanity webhook).
REVALIDATE_SECRET=

# Used by the `sanity` CLI (dataset export / backups). Same as the public id.
SANITY_PROJECT_ID=r4b3vt07

# VERCEL_PROJECT_PRODUCTION_URL is set automatically by Vercel; don't set it locally.
